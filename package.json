{
  "name": "romm-for-desktop",
  "version": "0.1.0",
  "description": "Cartridge \u2014 RomM for Windows. Play your self-hosted RomM library locally: EmulatorJS + bundled RetroArch, no cloud server does the emulation. Unofficial; not affiliated with the RomM project.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "MoveWeight",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.moveweight.rommdesktop",
    "productName": "Cartridge",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "extraResources": [
      {
        "from": "native/retroarch",
        "to": "retroarch",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "RommForDesktop-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico"
    }
  }
}